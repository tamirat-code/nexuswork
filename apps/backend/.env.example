# Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# Database and authentication
MONGO_URI=mongodb://localhost:27017/nexuswork
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Payments
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
PAYMENT_CURRENCY=usd
COMMISSION_RATE=0.1
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/wallet?connect=refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/wallet?connect=done

# Google authentication
GOOGLE_CLIENT_ID=replace-me

# AI recommendations (use none to disable)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Email
RESEND_API_KEY=re_replace-me
MAIL_FROM=NexusWork <no-reply@localhost>
TERMS_VERSION=1.0

# Abuse prevention
RECAPTCHA_SECRET_KEY=replace-me
RECAPTCHA_MIN_SCORE=0.5

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
# Required when STORAGE_DRIVER=s3
S3_REGION=us-east-1
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
