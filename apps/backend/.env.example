PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/nexuswork
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Payments (Section 3.9) — sandbox mode by default
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=
COMMISSION_RATE=0.1

# AI recommendation module (Section 4.15) — runs inside this backend
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

MAIL_PROVIDER=console
MAIL_FROM=no-reply@nexuswork.local

STORAGE_DRIVER=local
UPLOAD_DIR=uploads
LOG_LEVEL=info
