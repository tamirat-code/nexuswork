PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/nexuswork
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173


PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_.......
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_CURRENCY=usd
COMMISSION_RATE=0.1
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/wallet/connect/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/wallet/connect/done
COMMISSION_RATE=0.1

# AI recommendation module (Section 4.15) — runs inside this backend
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

RESEND_API_KEY=re_...
MAIL_FROM=NexusWork <no-reply@yourdomain.com>
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
LOG_LEVEL=info
